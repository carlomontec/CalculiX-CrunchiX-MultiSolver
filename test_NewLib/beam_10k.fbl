pnt p1 0 0 0
pnt p2 20 0 0
pnt p3 20 20 0
pnt p4 0 20 0

line l1 p1 p2 16
line l2 p2 p3 16
line l3 p3 p4 16
line l4 p4 p1 16

surf s0 blend l1 l2 l3 l4

seta src s s0
swep src swp tra 0 0 500 250

elty all he20
mesh all

seta FIX s s0
seta NFIX n FIX

seta TIP s A001
seta NTIP n TIP

seta TOP s A004
comp TOP e
comp TOP f

send all abq
send NFIX abq names
send NTIP abq names
send TOP abq pres 0.2
quit
